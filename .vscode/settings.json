{
  "python.REPL.enableREPLSmartSend": false,

  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/flutter/ephemeral": true,
    "**/Flutter/ephemeral": true,
    "**/.symlinks": true,
    "**/.plugin_symlinks": true,
    "**/CVS": true,
    "**/.ruby-lsp": true,
    "**/.pyc": { "when": "$(basename).py" },
    "**/__pycache__": true,
    "**/__pytest_cache": true
  },

  "python.analysis.exclude": [
    "**/__pycache__",
    "**/__pytest_cache__",
    "**/.git",
    "**/.venv",
    "**/env",
    "**/build",
    "**/dist"
  ],

  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexServicesReferences": false,
  "python.analysis.packageIndexDepths": [{ "name": "", "depth": 2 }]
}
